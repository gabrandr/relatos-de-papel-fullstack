# OpenSearch (copiar también en relatos-de-papel-backend/.env)
OPENSEARCH_URL=https://<username>:<password>@<cluster-host>
OPENSEARCH_USERNAME=<username>
OPENSEARCH_PASSWORD=<password>
OPENSEARCH_INDEX=relatos

# URL del gateway vista desde el navegador del host
VITE_API_BASE_URL=http://localhost:8762
